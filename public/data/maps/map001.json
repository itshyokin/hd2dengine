    {
      "id": 3,
      "name": "Mira",
      "x": 6,
      "z": 7,
      "pages": [
        {
          "character": "mira",
          "dir": "down",
          "facePlayer": true,
          "trigger": "action",
          "solid": true,
          "commands": [
            {
              "cmd": "quest",
              "quest": "first_night",
              "op": "objective",
              "objective": "meet_mira"
            },
            {
              "cmd": "text",
              "speaker": "Mira",
              "text": "Oh! A traveller. Not many come out this way after dusk."
            },
            {
              "cmd": "text",
              "speaker": "Mira",
              "text": "If you're staying, the campfire up the path is warm. Rest there whenever you like."
            },
            {
              "cmd": "text",
              "speaker": "Mira",
              "text": "Here, take this. It's an old Leaf Ring: wear it and press 4 to cut through vines."
            },
            {
              "cmd": "giveItem",
              "item": "leaf_ring",
              "count": 1
            },
            {
              "cmd": "text",
              "speaker": "Mira",
              "text": "Something glints in the brush to the west, behind the vines."
            },
            {
              "cmd": "text",
              "speaker": "Mira",
              "text": "One more thing. Slimes keep getting into my supplies.\nIf you're handy with that sword, could you clear out three of them?"
            },
            {
              "cmd": "quest",
              "quest": "slime_trouble",
              "op": "start"
            },
            {
              "cmd": "setVar",
              "var": "mira_talks",
              "op": "set",
              "value": 1
            },
            {
              "cmd": "setSwitch",
              "switch": "met_mira",
              "value": true
            }
          ]
        },
        {
          "condition": {
            "switch": "met_mira"
          },
          "character": "mira",
          "dir": "left",
          "facePlayer": true,
          "trigger": "action",
          "solid": true,
          "commands": [
            {
              "cmd": "setVar",
              "var": "mira_talks",
              "op": "add",
              "value": 1
            },
            {
              "cmd": "if",
              "condition": {
                "quest": "slime_trouble",
                "is": "ready"
              },
              "then": [
                {
                  "cmd": "text",
                  "speaker": "Mira",
                  "text": "You got them? Thank you! My bread might survive the week now."
                },
                {
                  "cmd": "text",
                  "speaker": "Mira",
                  "text": "Here, it isn't much, but take these."
                },
                {
                  "cmd": "quest",
                  "quest": "slime_trouble",
                  "op": "complete"
                }
              ],
              "else": []
            },
            {
              "cmd": "text",
              "speaker": "Mira",
              "text": "Back again? That's visit number \\v[mira_talks]."
            },
            {
              "cmd": "text",
              "speaker": "Mira",
              "text": "Something on your mind?"
            },
            {
              "cmd": "choice",
              "options": [
                "Which way is the fire?",
                "Got anything to trade?",
                "Just saying hi."
              ],
              "cancel": 2,
              "branches": [
                [
                  {
                    "cmd": "text",
                    "speaker": "Mira",
                    "text": "Follow the path north, then turn east at the old sign."
                  }
                ],
                [
                  {
                    "cmd": "text",
                    "speaker": "Mira",
                    "text": "A little. Have a look."
